{
  "name": "react-router-v7-ssr-cloudflare",
  "version": "1.0.0",
  "description": "React Router v7 SSR application for Cloudflare Pages",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && pnpm start",
    "cf:dev": "wrangler pages dev ./build/client",
    "cf:deploy": "pnpm build && wrangler pages deploy ./build/client"
  },
  "dependencies": {
    "@react-router/dev": "^7.6.2",
    "@react-router/node": "^7.9.6",
    "@tanstack/react-query": "^5.63.0",
    "ahooks": "^3.9.6",
    "isbot": "^5",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.6.2",
    "react-vant": "^3.3.5",
    "sass-embedded": "^1.93.3",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-style-import": "^2.0.0",
    "wrangler": "^3.22.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.14.3"
}
