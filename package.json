{
  "name": "react-router-v7-ssr-cloudflare",
  "version": "1.0.0",
  "description": "React Router v7 SSR application for Cloudflare Pages",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && pnpm start",
    "cf:dev": "wrangler pages dev ./build/client",
    "cf:deploy": "pnpm build && wrangler pages deploy ./build/client"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.6.2",
    "@react-router/dev": "^7.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251128.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wrangler": "^3.22.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.14.3"
}
